#!/bin/sh
# ブランチ切替で前の app-* ブランチの gitignore 済みファイルが _Apps / _Core / _Browser に残り、次のビルドを壊すのを防ぐ（#239）。
# 導入は clone ごとに 1 回: cp .githooks/post-checkout .git/hooks/

# $3 が 1 以外はファイル単位の checkout
[ "$3" = 1 ] || exit 0
# 切替前が null-sha（全桁 0）なら clone / git worktree add
case "$1" in *[!0]*) ;; *) exit 0 ;; esac
# .sln / .csproj に差分が無い切替（csproj を変えない fix/* との往復）では消さない
git diff --quiet "$1" "$2" -- '_Apps/*.sln' '_Apps/*.csproj' '_Core/*.csproj' '_Browser/*.csproj' && exit 0

git clean -fdX -- _Apps _Core _Browser
# フックの終了コードが checkout / switch の終了コードになるため、消せなかったファイルは stderr の警告だけ残して 0 で終える
exit 0
