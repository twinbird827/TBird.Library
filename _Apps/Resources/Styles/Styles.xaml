<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:converters="clr-namespace:TBird.Maui.Converters;assembly=TBird.Maui">

    <Color x:Key="Primary">#37474F</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="ErrorRed">#E53935</Color>
    <Color x:Key="OverlayBg">#B0000000</Color>

    <converters:InverseBoolConverter x:Key="InverseBool" />
    <converters:BoolToOpacityConverter x:Key="EnabledOpacity" />

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="Shell.ForegroundColor" Value="White" />
        <Setter Property="Shell.TitleColor" Value="White" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="BarTextColor" Value="White" />
    </Style>

    <Style x:Key="ItemName" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=Black, Dark=White}" />
    </Style>

    <Style x:Key="SubText" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="TextColor" Value="{StaticResource Gray500}" />
    </Style>

    <Style x:Key="GroupHeader" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource Gray500}" />
        <Setter Property="Padding" Value="16,16,16,4" />
    </Style>

    <Style x:Key="ErrorText" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource ErrorRed}" />
    </Style>

    <Style x:Key="OverlayButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="4" />
    </Style>

</ResourceDictionary>
