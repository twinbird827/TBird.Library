<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
  </PropertyGroup>

  <!-- Core は net10.0-android 単一 TFM でホストの dotnet test から参照できないため、BCL のみに依存するファイルをリンクする -->
  <ItemGroup>
    <Compile Include="..\NewReleaseChecker.Core\Services\CoverImageUrl.cs" Link="Linked\CoverImageUrl.cs" />
    <Compile Include="..\NewReleaseChecker.Core\Services\ReleaseDateParser.cs" Link="Linked\ReleaseDateParser.cs" />
    <Compile Include="..\NewReleaseChecker.Core\Collections\BulkObservableCollection.cs" Link="Linked\BulkObservableCollection.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>

</Project>
