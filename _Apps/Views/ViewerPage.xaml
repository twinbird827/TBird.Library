<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ComicViewer.ViewModels"
             xmlns:controls="clr-namespace:ComicViewer.Views.Controls"
             x:Class="ComicViewer.Views.ViewerPage"
             x:DataType="vm:ViewerViewModel"
             Shell.FlyoutBehavior="Disabled"
             Shell.NavBarIsVisible="False"
             BackgroundColor="Black">

    <Grid x:Name="Root">
        <controls:PageImageView x:Name="PrevView" Bitmap="{Binding PrevBitmap}" />
        <controls:PageImageView x:Name="NextView" Bitmap="{Binding NextBitmap}" />
        <controls:PageImageView x:Name="CurrentView" Bitmap="{Binding CurrentBitmap}" />

        <ActivityIndicator IsRunning="{Binding IsPageLoading}" IsVisible="{Binding IsPageLoading}" Color="White"
                           HorizontalOptions="Center" VerticalOptions="Center" />
        <Label Text="読み込めませんでした" TextColor="White" IsVisible="{Binding HasPageError}"
               HorizontalOptions="Center" VerticalOptions="Center" />
        <VerticalStackLayout IsVisible="{Binding IsDownloading}" HorizontalOptions="Center" VerticalOptions="Center"
                             Spacing="8" WidthRequest="240">
            <ProgressBar Progress="{Binding DownloadProgress}" ProgressColor="White" />
            <Label Text="{Binding DownloadText}" TextColor="White" HorizontalOptions="Center" />
            <Button Text="キャンセル" Command="{Binding CancelDownloadCommand}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- 操作レイヤ: タップとスワイプを受ける。DL 中はボタンへ触れるよう無効にする -->
        <BoxView x:Name="TouchLayer" Color="Transparent"
                 InputTransparent="{Binding IsDownloading}">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTapped" />
                <PanGestureRecognizer PanUpdated="OnPanUpdated" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding IsOverlayVisible}" InputTransparent="False" CascadeInputTransparent="False">
            <Label x:Name="TopBar" Text="{Binding ComicName}" BackgroundColor="{StaticResource OverlayBg}" TextColor="White"
                   Padding="16,12" LineBreakMode="TailTruncation" MaxLines="1" />
            <BoxView Grid.Row="1" Color="Transparent">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <VerticalStackLayout x:Name="BottomPanel" Grid.Row="2" BackgroundColor="{StaticResource OverlayBg}" Padding="12,8" Spacing="4">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Slider x:Name="PageSlider" Minimum="0" Maximum="{Binding MaxPage}" Value="{Binding SliderValue}"
                            FlowDirection="RightToLeft" DragCompleted="OnSliderDragCompleted"
                            MinimumTrackColor="White" MaximumTrackColor="Gray" ThumbColor="White" />
                    <Label Grid.Column="1" Text="{Binding PageLabel}" TextColor="White" VerticalOptions="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,*,*,*,*,*">
                    <Button Grid.Column="0" Text="次の漫画" Command="{Binding NextComicCommand}" Style="{StaticResource OverlayButton}" />
                    <Button Grid.Column="1" Text="最後" Command="{Binding LastCommand}" Style="{StaticResource OverlayButton}" />
                    <Button Grid.Column="2" Text="次ページ" Command="{Binding NextCommand}" Style="{StaticResource OverlayButton}" />
                    <Button Grid.Column="3" Text="前ページ" Command="{Binding PrevCommand}" Style="{StaticResource OverlayButton}" />
                    <Button Grid.Column="4" Text="最初" Command="{Binding FirstCommand}" Style="{StaticResource OverlayButton}" />
                    <Button Grid.Column="5" Text="前の漫画" Command="{Binding PrevComicCommand}" Style="{StaticResource OverlayButton}" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Text="明るさ" TextColor="White" VerticalOptions="Center" />
                    <Slider Grid.Column="1" Minimum="0.01" Maximum="1" Value="{Binding Brightness}"
                            MinimumTrackColor="White" MaximumTrackColor="Gray" ThumbColor="White" />
                </Grid>
                <HorizontalStackLayout Spacing="8">
                    <Button Text="お気に入りに追加" Command="{Binding AddFavoriteCommand}" Style="{StaticResource OverlayButton}" />
                    <Button Text="再読み込み" Command="{Binding ReloadCommand}" IsVisible="{Binding HasPageError}"
                            Style="{StaticResource OverlayButton}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
