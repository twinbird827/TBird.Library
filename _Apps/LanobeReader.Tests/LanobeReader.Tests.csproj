<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- 取り込む本体ファイルが本体の implicit usings に依存するため揃える -->
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- 本体は net10.0-android の Exe で参照できないため、テスト対象ファイルだけをリンクで取り込む -->
    <Compile Include="..\LanobeReader\Services\Narou\NarouEpisodeParser.cs" Link="NarouEpisodeParser.cs" />
    <Compile Include="..\LanobeReader\Helpers\EpisodeContentFormat.cs" Link="EpisodeContentFormat.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\TBird.Maui.Web\TBird.Maui.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
  </ItemGroup>

</Project>
