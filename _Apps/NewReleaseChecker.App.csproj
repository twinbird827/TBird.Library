<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>NewReleaseChecker.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>

    <!-- アプリ表示情報 -->
    <ApplicationTitle>新刊チェッカー</ApplicationTitle>
    <ApplicationId>com.tbird.newreleasechecker</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Android 13 / API 33 以上 -->
    <SupportedOSPlatformVersion>33</SupportedOSPlatformVersion>

    <!-- ビルド警告の抑制（意図的な設計判断・良性ノイズのみ。実コードの警告は抑制しない）:
         NU1608 = MAUI 推移依存の AndroidX.* (Lifecycle/Fragment/Collection) Ktx パッケージが
           要求する Jvm/Runtime/Common より新しい版が解決される制約超過。AndroidX は後方互換のため良性。 -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon / Splash -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#2E7D32" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#2E7D32" BaseSize="128,128" />
    <!-- Images / Fonts / Raw -->
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- .NET 8 以降 UseMaui=true は Microsoft.Maui.Controls を自動参照しない（MA002）。
         リポジトリ規約（TBird.Maui と同様）に倣い 10.0.* で明示参照する。 -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.*" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <!-- CommunityToolkit.Maui は 13.x が .NET 10 対応（12.x は .NET 9 専用）。 -->
    <PackageReference Include="CommunityToolkit.Maui" Version="13.*" />
    <!-- 13.0.0 は net10.0-android36 もサポート（net10 移行後も据え置き。14.x へ上げる場合は
         タップ EventArgs 名前空間等の API 変更に注意）。 -->
    <PackageReference Include="Plugin.LocalNotification" Version="13.0.0" />
    <PackageReference Include="Xamarin.AndroidX.Work.Runtime" Version="2.11.2" />
  </ItemGroup>

  <!-- AndroidX SavedState の core/ktx バージョン不一致による重複クラス（androidx.savedstate.ViewKt）を回避。
       ktx を core と同一バージョンに揃える（新しい ktx aar は core に統合済みのスタブ）。 -->
  <ItemGroup>
    <PackageReference Include="Xamarin.AndroidX.SavedState" Version="1.3.1.1" />
    <PackageReference Include="Xamarin.AndroidX.SavedState.SavedState.Ktx" Version="1.3.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\_Core\NewReleaseChecker.Core\NewReleaseChecker.Core.csproj" />
    <ProjectReference Include="..\_Core\NewReleaseChecker.Data\NewReleaseChecker.Data.csproj" />
    <ProjectReference Include="..\TBird.Maui\TBird.Maui.csproj" />
    <ProjectReference Include="..\TBird.Maui.Background\TBird.Maui.Background.csproj" />
  </ItemGroup>

  <!-- 秘密情報の正本は中継サーバーと共有する _Tools/NewReleaseChecker/appsettings.Secrets.json（_Apps 内はブランチ切替の掃除で消えるため）。
       楽天キーを APK に入れないため、App が使う 2 値だけを抜いて Secrets クラスを生成する。 -->
  <PropertyGroup>
    <SecretsJsonPath>$(MSBuildProjectDirectory)\..\_Tools\NewReleaseChecker\appsettings.Secrets.json</SecretsJsonPath>
  </PropertyGroup>

  <!-- IntermediateOutputPath は本体より後の SDK targets で決まるため、プロパティに写さずアイテム・ターゲット内で直接参照する。 -->
  <ItemGroup>
    <Compile Include="$(IntermediateOutputPath)Secrets.g.cs" />
    <UpToDateCheckInput Include="$(SecretsJsonPath)" />
  </ItemGroup>

  <Target Name="GenerateSecrets" BeforeTargets="CoreCompile" Inputs="$(SecretsJsonPath);$(MSBuildProjectFullPath)" Outputs="$(IntermediateOutputPath)Secrets.g.cs">
    <GenerateSecretsClass JsonPath="$(SecretsJsonPath)" OutputPath="$(IntermediateOutputPath)Secrets.g.cs" />
    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)Secrets.g.cs" />
    </ItemGroup>
  </Target>

  <!-- System.Text.Json は dotnet build のインラインタスクから参照を解決できないため、JsonReaderWriterFactory で読む。 -->
  <UsingTask TaskName="GenerateSecretsClass" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <JsonPath ParameterType="System.String" Required="true" />
      <OutputPath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Runtime.Serialization.Json" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Xml" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        if (!File.Exists(JsonPath))
        {
            Log.LogError("秘密情報の正本がありません: " + JsonPath);
            return false;
        }

        XElement root;
        try
        {
            using (var reader = JsonReaderWriterFactory.CreateJsonReader(File.ReadAllBytes(JsonPath), XmlDictionaryReaderQuotas.Max))
            {
                root = XElement.Load(reader);
            }
        }
        catch (XmlException ex)
        {
            Log.LogError("秘密情報の正本を厳格な JSON として読めません（コメント・末尾カンマ不可）: " + JsonPath + ": " + ex.Message);
            return false;
        }

        Func<string, string, string> read = (section, key) =>
        {
            var element = root.Element(section);
            var value = element == null ? null : (string)element.Element(key);
            if (string.IsNullOrEmpty(value))
            {
                Log.LogError("秘密情報の正本に " + section + ":" + key + " がないか空です: " + JsonPath);
            }
            return (value ?? "").Replace("\"", "\"\"");
        };

        var apiKey = read("RelayAuth", "SharedSecret");
        var lanEndPoint = read("App", "RelayLanEndPoint");
        if (Log.HasLoggedErrors)
        {
            return false;
        }

        Directory.CreateDirectory(Path.GetDirectoryName(OutputPath));
        File.WriteAllText(OutputPath,
            "namespace NewReleaseChecker.App;\r\n\r\n" +
            "internal sealed class Secrets : global::NewReleaseChecker.Core.Abstractions.ISecretsProvider\r\n" +
            "{\r\n" +
            "    public string RelayServerApiKey => @\"" + apiKey + "\";\r\n" +
            "    public string RelayLanEndPoint => @\"" + lanEndPoint + "\";\r\n" +
            "}\r\n",
            new UTF8Encoding(false));
]]></Code>
    </Task>
  </UsingTask>

</Project>
