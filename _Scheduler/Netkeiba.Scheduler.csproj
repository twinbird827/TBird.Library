<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <SatelliteResourceLanguages>_</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- TBird.IO.Img と同じ版に揃える -->
    <PackageReference Include="SkiaSharp" Version="4.153.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TBird.Core\TBird.Core.csproj" />
    <ProjectReference Include="..\TBird.DB.SQLite\TBird.DB.SQLite.csproj" />
    <ProjectReference Include="..\TBird.DB\TBird.DB.csproj" />
    <ProjectReference Include="..\TBird.Web\TBird.Web.csproj" />
    <ProjectReference Include="..\_Core\Netkeiba.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\_Apps\lib\path-setting.json" Link="lib\path-setting.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
